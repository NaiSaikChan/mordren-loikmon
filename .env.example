# Environment templates:
#   .env.production.example        → production stack (docker-compose.prod.yml), see DEPLOYMENT.md
#   packages/backend/.env.example  → backend local development
#   packages/web/.env.example      → web app (VITE_API_BASE, store links)
#   packages/mobile/.env.example   → Expo app (EXPO_PUBLIC_API_BASE)
#
# The legacy BFF (packages/server) is no longer deployed. Its settings, if you
# still run it locally:
PORT=4000
LOIKMON_API_BASE=https://loikmon.org/webapis
CORS_ORIGINS=http://localhost:5173
