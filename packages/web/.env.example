# Copy to .env.local
# Loikmon backend API. `npm run dev` proxies /api to http://localhost:4001 (packages/backend).
VITE_API_BASE=/api/v1

# The web app cannot sell subscriptions: users subscribe in the Loikmon mobile app.
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=org.loikmon.mobile
# Replace with the App Store listing URL (https://apps.apple.com/app/id<APP_ID>) once published.
VITE_APP_STORE_URL=https://apps.apple.com/search?term=loikmon

# Optional policy links shown on the About page.
# VITE_TERMS_URL=https://loikmon.org/terms
# VITE_PRIVACY_URL=https://loikmon.org/privacy
