{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {},
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "prebuild": "npm install --workspaces"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "maraohnonpon@hotmail.com",
        "ascAppId": "6815781800",
        "appleTeamId": "86SZC8RRQ7"
      }
    }
  }
}
