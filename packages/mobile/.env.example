# Loikmon backend base URL (Express + MySQL, `/api/v1`).
# Resolution order: EXPO_PUBLIC_API_BASE → app.json `expo.extra.apiBaseUrl` → https://api.loikmon.org/api/v1
EXPO_PUBLIC_API_BASE=https://api.loikmon.org/api/v1

# Local development against `packages/backend` (default port 4001):
#   iOS simulator, or Android emulator / USB device after `npm run android:reverse`:
# EXPO_PUBLIC_API_BASE=http://localhost:4001/api/v1
#   Media (covers, PDF, EPUB, audio) comes from MinIO at http://localhost:9000. Presigned
#   URLs only verify on that exact host, so on Android use `npm run android:reverse`
#   rather than 10.0.2.2 (see README "Images, PDF, EPUB and audio").

# Optional origin used to resolve legacy *relative* media paths (covers/avatars).
# The new backend returns absolute (and, for files, signed) URLs, so this is rarely needed.
# EXPO_PUBLIC_MEDIA_ORIGIN=https://loikmon.org

# Crash + performance monitoring (Sentry). Leave unset to disable reporting
# (local development, CI). The DSN is public by design; it only allows sending events.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Build-time only (EAS secrets), for uploading source maps / debug symbols:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
