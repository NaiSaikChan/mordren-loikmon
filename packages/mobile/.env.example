# Loikmon backend base URL (Express + MySQL, `/api/v1`).
# Resolution order: EXPO_PUBLIC_API_BASE → app.json `expo.extra.apiBaseUrl` → https://api.loikmon.org/api/v1
EXPO_PUBLIC_API_BASE=https://api.loikmon.org/api/v1

# Local development against `packages/backend` (default port 4001):
#   Android emulator: the host machine is reachable at 10.0.2.2
# EXPO_PUBLIC_API_BASE=http://10.0.2.2:4001/api/v1
#   iOS simulator:
# EXPO_PUBLIC_API_BASE=http://localhost:4001/api/v1
#   Physical device: use your computer's LAN IP, e.g. http://192.168.1.20:4001/api/v1

# Optional origin used to resolve legacy *relative* media paths (covers/avatars).
# The new backend returns absolute (and, for files, signed) URLs, so this is rarely needed.
# EXPO_PUBLIC_MEDIA_ORIGIN=https://loikmon.org
