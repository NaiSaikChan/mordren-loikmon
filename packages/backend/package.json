{
  "name": "@loikmon/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Loikmon core backend — Express 5 + MySQL + Better Auth. Subscription entitlements verified with Google Play Billing & Apple App Store, content files in MinIO.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run build -w @loikmon/media-standards",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build -w @loikmon/media-standards",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build -w @loikmon/media-standards",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @loikmon/media-standards",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build -w @loikmon/media-standards",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:migrate:down": "tsx src/cli/migrate-down.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "storage:init": "tsx src/cli/storage-init.ts",
    "jobs:reconcile": "tsx src/cli/reconcile.ts",
    "import:legacy": "tsx src/cli/import-legacy.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@loikmon/media-standards": "*",
    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "kysely": "^0.29.5",
    "minio": "^7.1.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
