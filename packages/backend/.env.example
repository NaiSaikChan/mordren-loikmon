# Local development — copy to packages/backend/.env
# Start infrastructure first:  docker compose up -d mysql minio   (from the repo root)

NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
PUBLIC_API_URL=http://localhost:4001
APP_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loikmon
DB_PASSWORD=loikmon
DB_NAME=loikmon
DB_MIGRATE_ON_BOOT=true

AUTH_SECRET=local-dev-secret-change-me-local-dev-secret
AUTH_REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAILS=admin@loikmon.local

# Leave SMTP_HOST empty to print emails (verification / reset links) to the log
SMTP_HOST=
MAIL_FROM=Loikmon <no-reply@loikmon.org>

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_PUBLIC=loikmon-public
MINIO_BUCKET_PRIVATE=loikmon-private
SIGNED_URL_TTL_SECONDS=3600
# Optional: CDN origin in front of the public bucket; public asset URLs use it.
MEDIA_CDN_URL=
# Can only lower the per-category limits in packages/media-standards (images 10 MB, documents 250 MB, audio 1 GB).
UPLOAD_MAX_MB=1024

# Store billing is optional locally. See DEPLOYMENT.md for how to obtain these.
APPLE_BUNDLE_ID=
APPLE_APP_APPLE_ID=
APPLE_ALLOW_SANDBOX=true
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Set to import/migrate from the old API (npm run import:legacy, lazy login migration)
LEGACY_API_BASE=

JOBS_ENABLED=true
JOBS_RECONCILE_INTERVAL_MINUTES=60

# Integration tests (npm run test:integration) — database is dropped/recreated
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=root
