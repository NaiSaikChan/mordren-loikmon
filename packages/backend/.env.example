# ─── Deployment / Traefik ───────────────────────────────────────────────────
API_DOMAIN=api.loikmon.com
CDN_DOMAIN=cdn.loikmon.com

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=https://app.loikmon.com

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate a strong value: openssl rand -base64 48
AUTH_SECRET=__CHANGE_ME__
AUTH_JWT_EXPIRES_IN=7d

# ─── Database (MySQL) ───────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=loikmon
DB_PASSWORD=__CHANGE_ME__
DB_ROOT_PASSWORD=__CHANGE_ME__
DB_NAME=loikmon
DB_POOL_SIZE=10
RUN_MIGRATIONS_ON_BOOT=true

# ─── MinIO object storage ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__
MINIO_REGION=us-east-1
MINIO_BUCKET_BOOKS=loikmon-books
MINIO_BUCKET_IMAGES=loikmon-images
MINIO_BUCKET_AUDIO=loikmon-audio
# Public base URL for images bucket (via Traefik/CDN), e.g. https://cdn.loikmon.com
MINIO_PUBLIC_BASE_URL=
MINIO_SIGNED_URL_TTL=3600

# ─── Google Play (Android IAP) ──────────────────────────────────────────────
GOOGLE_PLAY_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.loikmon.app
# Paste the service-account JSON as a single-line string (or mount a file).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_TOKEN=

# ─── Apple (iOS IAP) ────────────────────────────────────────────────────────
APPLE_IAP_ENABLED=false
APPLE_BUNDLE_ID=com.loikmon.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Production
APPLE_SHARED_SECRET=

# ─── Stripe (web subscriptions) ─────────────────────────────────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://app.loikmon.com/subscribe/success
STRIPE_CANCEL_URL=https://app.loikmon.com/subscribe/cancel
# Per-plan Stripe price IDs (referenced by domain/plans.ts storeProductIds.stripePriceEnv)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_YEARLY=
