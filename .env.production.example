# ─────────────────────────────────────────────────────────────────────────────
# Loikmon production environment — copy to .env.production on the VPS.
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# Public hostnames (DNS A records pointing at the VPS)
APP_DOMAIN=app.loikmon.org
API_DOMAIN=api.loikmon.org
STORAGE_DOMAIN=storage.loikmon.org
# Extra browser origins allowed by CORS, comma-prefixed, e.g. ",https://naisaikchan.github.io"
EXTRA_CORS_ORIGINS=

# Database
DB_NAME=loikmon
DB_USER=loikmon
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_BUFFER_POOL=512M
BACKUP_RETENTION_DAYS=14

# Auth (at least 32 random characters)
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=admin@loikmon.org

# Email (Hostinger mail: smtp.hostinger.com:465 SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@loikmon.org
SMTP_PASSWORD=
MAIL_FROM=Loikmon <no-reply@loikmon.org>

# MinIO (object storage for covers, books, audio)
MINIO_ACCESS_KEY=loikmon-storage
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET_PUBLIC=loikmon-public
MINIO_BUCKET_PRIVATE=loikmon-private
SIGNED_URL_TTL_SECONDS=3600

# Apple App Store (iOS in-app subscriptions)
APPLE_BUNDLE_ID=com.loikmon.mobile
# App Store Connect → App Information → Apple ID (numeric)
APPLE_APP_APPLE_ID=
# Accept sandbox purchases (App Review + TestFlight use the sandbox)
APPLE_ALLOW_SANDBOX=true
# App Store Connect → Users and Access → Integrations → In-App Purchase key (.p8)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Paste the .p8 contents on one line with \n for newlines
APPLE_PRIVATE_KEY=

# Google Play (Android subscriptions)
GOOGLE_PLAY_PACKAGE_NAME=com.loikmon.mobile
# Service-account key JSON (raw or base64) with access to the app in Play Console
GOOGLE_SERVICE_ACCOUNT_JSON=
# Pub/Sub push subscription (authentication enabled) for real-time developer notifications
GOOGLE_PUBSUB_AUDIENCE=https://api.loikmon.org/api/v1/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Store listing links shown on the web subscription page
APP_STORE_URL=https://apps.apple.com/app/id0000000000
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.loikmon.mobile

# Migrate legacy accounts on first sign-in (remove once the old API is retired)
LEGACY_API_BASE=https://loikmon.org/webapis

LOG_LEVEL=info
JOBS_RECONCILE_INTERVAL_MINUTES=60
IMAGE_TAG=latest
